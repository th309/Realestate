{
  "name": "rei-platform",
  "version": "1.0.2",
  "private": true,
  "description": "Real Estate Investment Analysis Platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:fresh": "bash scripts/dev-start.sh",
    "dev:backend": "npm run start:dev -w backend",
    "dev:frontend": "npm run dev -w web",
    "build": "npm run build:libs && npm run build -w backend && npm run build -w web",
    "build:backend": "npm run build:libs && npm run build -w backend",
    "build:frontend": "npm run build:libs && npm run build -w web",
    "lint": "npm run lint -w backend && npm run lint -w web",
    "test": "npm run test -w backend",
    "test:frontend": "npm run test -w web",
    "test:data-matrix": "npm run test:unit -w web -- __tests__/data-cards.test.ts",
    "test:locations": "npm run test:unit -w web -- __tests__/location-coverage.test.ts",
    "test:api": "npm run test -w backend -- --testPathPatterns=api-endpoints",
    "test:all": "npm run test:frontend && npm run test",
    "clean": "rimraf --glob node_modules \"packages/*/node_modules\" \"packages/*/dist\" \"packages/*/.next\"",
    "zillow:import": "npx tsx scripts/zillow-import/import-all.ts",
    "zillow:import:state": "npx tsx scripts/zillow-import/import-state.ts",
    "zillow:import:metro": "npx tsx scripts/zillow-import/import-metro.ts",
    "zillow:import:county": "npx tsx scripts/zillow-import/import-county.ts",
    "zillow:import:zip": "npx tsx scripts/zillow-import/import-zip.ts",
    "zillow:import:city": "npx tsx scripts/zillow-import/import-city.ts",
    "email:dev": "npm run dev -w @propertyiq/emails",
    "build:libs": "npm run build -w @propertyiq/analyzer-core && npm run build -w @propertyiq/emails",
    "release:main": "bash scripts/git/release-to-main.sh",
    "sync:develop": "bash scripts/git/release-to-main.sh --sync-only",
    "postinstall": "node scripts/postinstall-fix-types.js && patch-package",
    "seo:rebuild-slugs": "npm run seo:slugs:metro && npm run seo:slugs:county && npm run seo:slugs:zip && npm run seo:redirects && npm run seo:generate-llms",
    "seo:slugs:metro": "npx tsx scripts/generate-metro-slugs.ts",
    "seo:slugs:county": "npx tsx scripts/generate-county-slugs.ts",
    "seo:slugs:zip": "npx tsx scripts/generate-zip-slugs.ts",
    "seo:redirects": "npx tsx scripts/generate-descored-redirects.ts",
    "seo:generate-llms": "npx tsx scripts/generate-llms-txt.ts"
  },
  "dependencies": {
    "csv-parse": "^5.6.0",
    "react-window": "^1.8.11",
    "stripe": "^20.3.1"
  },
  "devDependencies": {
    "@types/react-window": "^1.8.8",
    "concurrently": "^8.2.2",
    "node-fetch": "^3.3.2",
    "patch-package": "^8.0.1",
    "pg": "^8.16.3",
    "rimraf": "^5.0.5",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
