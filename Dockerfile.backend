# REI Platform - NestJS Backend (Railway)
# Optimized for layer caching: APT and npm install only re-run when deps change.

FROM node:22-bookworm-slim AS base

# 1. System dependencies - cached unless this layer changes
# content-pipeline P1 adds Python 3 + edge-tts (short-form TTS) and
# system Chromium + fonts for Puppeteer (lead-magnet PDF rendering).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    python3 \
    python3-pip \
    python3-venv \
    chromium \
    fonts-liberation \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# Install edge-tts (Microsoft's free TTS accessed via Python CLI).
# `--break-system-packages` is required on Debian bookworm to install
# into the system site-packages; safe because this is a container.
RUN pip3 install --no-cache-dir --break-system-packages edge-tts==6.1.12

# Puppeteer uses the system-installed Chromium above instead of downloading its own.
# Skipping the in-package download saves ~170MB on image size and build time.
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

# 2. Install Node dependencies (monorepo) - cached unless package*.json or lockfile change
COPY package.json package-lock.json ./
COPY packages/backend/package.json ./packages/backend/
COPY packages/emails/package.json ./packages/emails/
COPY packages/frontend/package.json ./packages/frontend/
COPY packages/video-template/package.json ./packages/video-template/
# Postinstall script must exist before npm ci
COPY scripts/postinstall-fix-types.js ./scripts/
COPY packages/frontend/types/ ./packages/frontend/types/

RUN npm ci

# 3. Copy source and build backend (+ video-template CLI used by RemotionCLIRenderer)
COPY . .

# video-template is a workspace dep; RemotionCLIRenderer resolves its compiled
# CLI at provider-construction time (require.resolve of dist/cli/render-cli.js),
# so the dist must exist before Nest boots the content-pipeline module.
RUN npm run build:cli -w @propertyiq/video-template \
    && npm run build -w @propertyiq/emails \
    && npm run build:backend

# 4. Start
CMD ["node", "packages/backend/dist/main.js"]
