# Server
PORT=8000
DEBUG=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# CORS Configuration
# Comma-separated list of allowed origins for cross-origin requests
# Default includes localhost for development and production domains
#
# Development (default if not set):
#   http://localhost:3000,http://localhost:3001
#
# Production (recommended):
#   http://localhost:3000,http://localhost:3001,https://propertyiq.app,https://app.propertyiq.app,https://api.propertyiq.app
#
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://propertyiq.app,https://app.propertyiq.app,https://api.propertyiq.app

# Service-to-Service Authentication
# Shared secret for authenticating requests from the NestJS backend
# Generate with: openssl rand -hex 32
# Must match ANALYTICS_SERVICE_SECRET in backend
# If not set, authentication is disabled (development mode)
ANALYTICS_SERVICE_SECRET=your_shared_secret_here
