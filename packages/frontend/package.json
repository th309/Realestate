{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=6144 next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:data-matrix": "vitest run __tests__/data-cards.test.ts --reporter=verbose",
    "test:graph-matrix": "vitest run __tests__/graph-matrix.test.ts --reporter=verbose",
    "test:locations": "vitest run __tests__/location-coverage.test.ts --reporter=verbose",
    "test:all-matrix": "vitest run __tests__/*.test.ts --reporter=verbose",
    "test:full-matrix": "vitest run __tests__/full-matrix.test.ts --reporter=verbose --testTimeout=14400000",
    "test:zip-matrix": "vitest run __tests__/zip-matrix/state-tests --pool=threads --reporter=verbose --testTimeout=600000",
    "test:zip-matrix:state": "vitest run __tests__/zip-matrix/state-tests/${STATE}.test.ts --reporter=verbose --testTimeout=600000",
    "test:zip-matrix:report": "npx tsx __tests__/zip-matrix/reporter.ts",
    "test:zip-matrix:generate": "npx tsx __tests__/zip-matrix/generate-state-tests.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mapbox/polylabel": "^1.0.2",
    "@next/bundle-analyzer": "^16.2.10",
    "@propertyiq/analyzer-core": "*",
    "@propertyiq/emails": "*",
    "@sentry/nextjs": "^10.47.0",
    "@serwist/next": "^9.5.11",
    "@serwist/window": "^9.5.11",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.80.0",
    "@tanstack/query-async-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "@types/recharts": "^1.8.29",
    "adm-zip": "^0.5.16",
    "axios": "^1.13.2",
    "canvas-confetti": "^1.9.4",
    "csv-parse": "^6.1.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.33.0",
    "gray-matter": "^4.0.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.562.0",
    "mapbox-gl": "^3.17.0",
    "next": "^16.1.1",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-map-gl": "^8.1.0",
    "react-markdown": "^9.0.3",
    "reading-time": "^1.5.0",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.0",
    "resend": "^6.9.2",
    "serwist": "^9.5.11",
    "shapefile": "^0.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3": "^7.4.3",
    "@types/mapbox__point-geometry": "^1.0.87",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20.19.28",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "imapflow": "^1.4.1",
    "jsdom": "^27.4.0",
    "supabase": "^2.58.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.17"
  }
}
