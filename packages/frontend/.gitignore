# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Parallel/isolated dist dirs: .next-dev (dev server), .next-verify, .next-test, .next-mobile
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Serwist-generated service worker build output (public/sw.js is built from
# app/sw.ts by @serwist/next; never commit the generated bundle or its
# source map / worker chunks — see next.config.mjs).
/public/sw.js
/public/sw.js.map
/public/swe-worker*.js
/public/swe-worker*.js.map
