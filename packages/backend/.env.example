# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# Redis (Upstash)
REDIS_URL=your_upstash_redis_url

# API Keys
ANTHROPIC_API_KEY=your_anthropic_key
DEEPSEEK_API_KEY=your_deepseek_key

# AI Provider Configuration (Quinn Chat)
# Options: 'anthropic' (default), 'openai'
# Fallback is automatic if both keys are present.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5-20250929

# OpenAI/DeepSeek Configuration (Used if AI_PROVIDER=openai OR as fallback)
AI_BASE_URL=https://api.deepseek.com/v1

# Market Intelligence
# Toggle briefing generation cron (weekly, Sunday 2am)
BRIEFING_GENERATION_ENABLED=true
# Toggle news ingestion cron (daily, 6am)
NEWS_INGESTION_ENABLED=true
# Toggle rankings cache refresh cron (weekly, Sunday 3am)
RANKINGS_CACHE_ENABLED=true

# News API (for market news ingestion)
# Get a key at https://newsapi.org
NEWS_API_KEY=your_news_api_key
NEWS_API_PROVIDER=newsapi

# App
PORT=3001
NODE_ENV=production

# Analytics Service
# URL of the PropertyIQ Analytics microservice for scoring/backtesting
# Local: http://localhost:8000
# Production: https://analytics-production-af35.up.railway.app
# Note: This is also used in CORS whitelist to allow analytics service callbacks
ANALYTICS_SERVICE_URL=http://localhost:8000

# Shared secret for service-to-service auth between backend and analytics service
# Generate with: openssl rand -hex 32
# Must match ANALYTICS_SERVICE_SECRET in propertyiq-analytics
ANALYTICS_SERVICE_SECRET=your_shared_secret_here

# CORS Configuration
# Frontend URL for CORS whitelist (defaults to http://localhost:3000)
FRONTEND_URL=http://localhost:3000
# Next.js public app URL (optional, added to CORS whitelist if set)
NEXT_PUBLIC_APP_URL=