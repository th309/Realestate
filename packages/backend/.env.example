# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# Redis (Upstash)
REDIS_URL=your_upstash_redis_url

# API Keys
ANTHROPIC_API_KEY=your_anthropic_key

# App
PORT=3001
NODE_ENV=production

# ML Workflow
# Python path for running ML scripts. On Windows, python3 may point to
# Windows Store stub without packages installed - use 'python' instead.
PYTHON_PATH=python