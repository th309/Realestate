# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# Redis (Upstash)
REDIS_URL=your_upstash_redis_url

# Mapbox (required for long-form Remotion renders: US→market fly-in is bundled at render time)
# Use the same access token as the frontend map; must be present on the backend worker that runs render_video.
MAPBOX_ACCESS_TOKEN=

# API Keys
ANTHROPIC_API_KEY=your_anthropic_key
DEEPSEEK_API_KEY=your_deepseek_key

# AI Provider Configuration
# Options: 'anthropic' (default), 'openai'
# Fallback is automatic if both keys are present.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5-20250929

# OpenAI/DeepSeek Configuration (Used if AI_PROVIDER=openai OR as fallback)
AI_BASE_URL=https://api.deepseek.com/v1

# Pipeline Status Reporting
# Shared secret for import scripts to POST status to /api/health/pipeline-status
# Generate with: node -e "console.log(require('crypto').randomUUID())"
PIPELINE_API_KEY=

# Internal API URL (used by import scripts to reach the backend)
# Local: http://localhost:3001  |  Production: set to Railway internal URL
INTERNAL_API_URL=http://localhost:3001

# App
PORT=3001
NODE_ENV=production

# Analytics Service
# URL of the PropertyIQ Analytics microservice for scoring/backtesting
# Local: http://localhost:8000
# Production: https://analytics-production-af35.up.railway.app
# Note: This is also used in CORS whitelist to allow analytics service callbacks
ANALYTICS_SERVICE_URL=http://localhost:8000

# Shared secret for service-to-service auth between backend and analytics service
# Generate with: openssl rand -hex 32
# Must match ANALYTICS_SERVICE_SECRET in propertyiq-analytics
ANALYTICS_SERVICE_SECRET=your_shared_secret_here

# CORS Configuration
# Frontend URL for CORS whitelist (defaults to http://localhost:3000).
# Also used as the public app base URL for device-auth verification_url
# (POST /api/auth/device-code → `${FRONTEND_URL}/activate`) when PUBLIC_APP_URL is unset.
FRONTEND_URL=http://localhost:3000
# Public app base URL (preferred; overrides FRONTEND_URL for device-auth verification_url).
# Set this if the public-facing host differs from the CORS-whitelisted FRONTEND_URL.
PUBLIC_APP_URL=
# Next.js public app URL (optional, added to CORS whitelist if set)
NEXT_PUBLIC_APP_URL=
# Admin alerts
ADMIN_EMAIL=

# Scheduled jobs (cron) master switch. Set to "true" on EXACTLY ONE production
# backend service (backend-production-ee4d). Leave UNSET on dev, local, preview,
# and any other service — they share the production Supabase DB, so running crons
# there double-sends emails and corrupts prod data. Unset = no @Cron runs.
RUN_CRONS=
