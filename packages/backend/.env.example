# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# Redis (Upstash)
REDIS_URL=your_upstash_redis_url

# API Keys
ANTHROPIC_API_KEY=your_anthropic_key
DEEPSEEK_API_KEY=your_deepseek_key

# AI Provider Configuration (Quinn Chat)
# Options: 'anthropic' (default), 'openai', 'novita', 'groq', 'deepseek'
AI_PROVIDER=anthropic
# Base URL for OpenAI-compatible providers (required for deepseek, novita, groq)
AI_BASE_URL=https://api.deepseek.com/v1
# Model name (defaults: 'claude-3-5-sonnet-latest' for anthropic, 'gpt-4o' for openai)
# Deepseek models: 'deepseek-chat' (V3.2 balanced), 'deepseek-reasoner' (V3.2-Special maxed reasoning)
AI_MODEL=deepseek-chat

# App
PORT=3001
NODE_ENV=production

# Analytics Service
# URL of the PropertyIQ Analytics microservice for scoring/backtesting
# Local: http://localhost:8000
# Production: https://analytics-production-af35.up.railway.app
ANALYTICS_SERVICE_URL=http://localhost:8000