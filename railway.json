{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd packages/backend && npm ci && pip install -r requirements.txt && npm run build",
    "watchPatterns": ["packages/backend/**"]
  },
  "deploy": {
    "startCommand": "cd packages/backend && node dist/main.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
