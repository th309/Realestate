# REI Platform - Next.js Frontend (Railway)
# Optimized for layer caching: APT and npm install only re-run when deps change.
# Uses Node 22 on Debian Bookworm; system Chromium for Puppeteer (Redfin scraping).
# Next.js standalone output mode for minimal image size.

FROM node:22-bookworm-slim AS base

# 1. System dependencies (Puppeteer/Chromium) - cached unless this layer changes
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    libnss3 \
    libxss1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libgtk-3-0 \
    libgbm-dev \
    fonts-liberation \
    ca-certificates \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Puppeteer: use system Chromium (no NPM download)
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

# 2. Install Node dependencies (monorepo) - cached unless package*.json or lockfile change
COPY package.json package-lock.json ./
COPY packages/backend/package.json ./packages/backend/
COPY packages/frontend/package.json ./packages/frontend/
COPY packages/propertyiq-analytics/package.json ./packages/propertyiq-analytics/
COPY packages/quinn-widget/package.json ./packages/quinn-widget/

RUN npm ci

# 3. Copy source and build frontend
# NEXT_PUBLIC_* env vars must be provided at build time via Railway service settings
COPY . .

RUN npm run build:frontend

# 4. Next.js standalone doesn't include public/ or .next/static/ — copy them manually
RUN cp -r packages/frontend/public packages/frontend/.next/standalone/packages/frontend/public
RUN cp -r packages/frontend/.next/static packages/frontend/.next/standalone/packages/frontend/.next/static

# 5. Start Next.js standalone server
# Railway injects PORT dynamically; Next.js standalone respects it via hostname/port env
ENV HOSTNAME="0.0.0.0"
CMD ["node", "packages/frontend/.next/standalone/server.js"]
